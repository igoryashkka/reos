{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug preset",
      "type": "shell",
      "command": "cmake --build --preset Debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flash Debug image",
      "type": "shell",
      "command": "openocd -f interface/stlink.cfg -f target/stm32h7x.cfg -c \"program build/Debug/H750VB.elf verify reset exit\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build and Flash Debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Debug preset",
        "Flash Debug image"
      ],
      "problemMatcher": []
    }
  ]
}